<!DOCTYPE html>
<html lang="ha">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Absam Clothing & Textile</title>

  <meta name="description"
        content="Barka da zuwa Absam Clothing & Textile. Zaɓi tufafi, duba kayayyaki, sannan ka aika odarka ta WhatsApp.">

  <style>
    :root {
      --black: #111111;
      --gold: #d4af37;
      --white: #ffffff;
      --light: #f5f5f5;
      --gray: #666666;
      --green: #25d366;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      background: var(--light);
      color: var(--black);
      line-height: 1.6;
    }

    header {
      background: var(--black);
      color: var(--white);
      text-align: center;
      padding: 24px 12px;
      border-bottom: 4px solid var(--gold);
    }

    header h1 {
      color: var(--gold);
      font-size: clamp(22px, 5vw, 34px);
    }

    header p {
      font-size: 14px;
    }

    nav {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 18px;
      background: #222;
      padding: 13px;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
      font-size: 14px;
    }

    nav a:hover {
      color: var(--gold);
    }

    .hero {
      text-align: center;
      padding: 65px 20px;
      background: var(--black);
      color: white;
    }

    .hero h2 {
      color: var(--gold);
      font-size: clamp(25px, 5vw, 38px);
      margin-bottom: 12px;
    }

    .hero p {
      max-width: 650px;
      margin: 0 auto 22px;
    }

    .button {
      display: inline-block;
      background: var(--gold);
      color: var(--black);
      padding: 12px 18px;
      border: none;
      border-radius: 5px;
      font-weight: bold;
      text-decoration: none;
      cursor: pointer;
      font-size: 15px;
    }

    .button:hover {
      background: #ebcd65;
    }

    .section {
      max-width: 1200px;
      padding: 38px 16px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      font-size: 27px;
      margin-bottom: 25px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(
        auto-fit,
        minmax(min(100%, 230px), 1fr)
      );
      gap: 20px;
    }

    .product {
      background: white;
      border-radius: 9px;
      overflow: hidden;
      box-shadow: 0 3px 12px #00000012;
      padding-bottom: 18px;
    }

    .product img {
      display: block;
      width: 100%;
      height: 250px;
      object-fit: cover;
      background: #ddd;
    }

    .product h3 {
      padding: 12px 13px 3px;
    }

    .product-description {
      padding: 0 13px;
      color: var(--gray);
      font-size: 14px;
    }

    .price {
      padding: 5px 13px;
      font-weight: bold;
      color: #947313;
      font-size: 19px;
    }

    .product label {
      display: block;
      padding: 7px 13px 3px;
      font-size: 13px;
      font-weight: bold;
    }

    .product select,
    .product input {
      display: block;
      width: calc(100% - 26px);
      margin: 0 13px;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 5px;
      background: white;
    }

    .product .button {
      display: block;
      width: calc(100% - 26px);
      margin: 15px 13px 0;
    }

    .box {
      background: white;
      padding: 22px;
      border-radius: 8px;
      box-shadow: 0 2px 10px #0000000c;
      margin-bottom: 20px;
    }

    .cart-item {
      padding: 14px 0;
      border-bottom: 1px solid #ddd;
    }

    .cart-item button {
      margin-top: 8px;
      padding: 6px 12px;
      cursor: pointer;
    }

    .cart-total {
      font-size: 21px;
      font-weight: bold;
      margin-top: 18px;
    }

    .empty {
      color: var(--gray);
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-weight: bold;
      margin-bottom: 6px;
    }

    .form-control {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 5px;
      font: inherit;
      background: white;
    }

    textarea.form-control {
      min-height: 100px;
      resize: vertical;
    }

    .help-text {
      color: var(--gray);
      font-size: 13px;
      margin-top: 5px;
    }

    .full-button {
      width: 100%;
      margin-top: 8px;
    }

    .about p {
      margin-bottom: 8px;
    }

    footer {
      background: var(--black);
      color: white;
      text-align: center;
      padding: 28px 15px;
      border-top: 4px solid var(--gold);
    }

    footer strong {
      color: var(--gold);
    }

    .whatsapp-float {
      position: fixed;
      right: 15px;
      bottom: 15px;
      background: var(--green);
      color: white;
      text-decoration: none;
      font-weight: bold;
      padding: 13px 17px;
      border-radius: 30px;
      z-index: 100;
      box-shadow: 0 3px 10px #0003;
    }

    @media (max-width: 480px) {
      .section {
        padding: 28px 12px;
      }

      nav {
        gap: 12px;
      }

      .product img {
        height: 220px;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header>
    <h1>ABSAM CLOTHING &amp; TEXTILE</h1>
    <p>Inganci shi ne alamar tela nagari.</p>
    <p>Tukuntawa, Gidan Rediyo</p>
  </header>

  <!-- NAVIGATION -->
  <nav>
    <a href="#home">Gida</a>
    <a href="#products">Kayayyaki</a>
    <a href="#cart">Cart</a>
    <a href="#order">Yi Oda</a>
    <a href="#about">Game da Mu</a>
  </nav>

  <!-- HOME -->
  <section class="hero" id="home">
    <h2>Barka da zuwa Absam Clothing</h2>

    <p>
      Ka zaɓi tufafin da kake so, ka duba farashinsu,
      sannan ka aika odarka kai tsaye ta WhatsApp.
      Muna maraba da kai!
    </p>

    <a href="#products" class="button">Duba Kayayyaki</a>
  </section>

  <!-- PRODUCTS -->
  <section class="section" id="products">
    <h2 class="section-title">Kayayyakinmu</h2>
    <div class="products" id="productsContainer"></div>
  </section>

  <!-- CART -->
  <section class="section" id="cart">
    <h2 class="section-title">Cart ɗinka</h2>

    <div class="box">
      <div id="cartItems">
        <p class="empty">Ba ka saka kaya a cart ba tukuna.</p>
      </div>

      <div class="cart-total" id="cartTotal">
        Jimilla: ₦0
      </div>

      <button class="button" onclick="clearCart()" style="margin-top:15px">
        Share Cart
      </button>
    </div>
  </section>

  <!-- ORDER FORM -->
  <section class="section" id="order">
    <h2 class="section-title">Yi Oda</h2>

    <div class="box">
      <form id="orderForm">

        <div class="form-group">
          <label for="customerName">Cikakken Sunanka</label>
          <input
            class="form-control"
            id="customerName"
            type="text"
            placeholder="Shigar da sunanka"
            required
          >
        </div>

        <div class="form-group">
          <label for="customerPhone">Lambar Wayarka</label>
          <input
            class="form-control"
            id="customerPhone"
            type="tel"
            placeholder="Misali: 08012345678"
            required
          >
        </div>

        <div class="form-group">
          <label for="customerAddress">Adireshin da Za a Kai Kaya</label>
          <textarea
            class="form-control"
            id="customerAddress"
            placeholder="Shigar da adireshinka"
            required
          ></textarea>
        </div>

        <div class="form-group">
          <label for="fabricImage">Hoton Yadi (Idan Kana da Shi)</label>
          <input
            class="form-control"
            id="fabricImage"
            type="file"
            accept="image/*"
          >
          <p class="help-text">
            Idan ka zaɓi hoton yadi, za ka buƙaci ka tura shi da kanka
            a WhatsApp bayan an buɗe tattaunawar.
          </p>
        </div>

        <div class="form-group">
          <label for="customerNotes">Ƙarin Bayani</label>
          <textarea
            class="form-control"
            id="customerNotes"
            placeholder="Rubuta irin ɗinkin da kake so ko wani ƙarin bayani"
          ></textarea>
        </div>

        <button class="button full-button" type="submit">
          Aika Oda ta WhatsApp
        </button>

      </form>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section" id="about">
    <h2 class="section-title">Game da Mu</h2>

    <div class="box about">
      <p>
        <strong>Absam Clothing &amp; Textile</strong>
        yana mai da hankali kan tufafi masu kyau, ɗinki mai inganci
        da salo na zamani.
      </p>

      <p><strong>Adireshi:</strong> Tukuntawa, Gidan Rediyo</p>

      <p><strong>WhatsApp:</strong> 09068560650</p>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <p><strong>ABSAM CLOTHING &amp; TEXTILE</strong></p>
    <p>Tukuntawa, Gidan Rediyo</p>
    <p>WhatsApp: 09068560650</p>
    <p>© <span id="year"></span> Absam Clothing</p>
  </footer>

  <!-- WHATSAPP SHORTCUT -->
  <a
    class="whatsapp-float"
    href="https://wa.me/2349068560650"
    target="_blank"
    rel="noopener noreferrer"
  >
    WhatsApp
  </a>

  <script>
    // BAYANAN KASUWANCI
    const BUSINESS = {
      whatsapp: "2349068560650"
    };

    // KAYAYYAKI
    // Sauya sunaye, farashi da hotuna zuwa na kasuwancinka.
    const products = [
      {
        id: 1,
        name: "Premium Kaftan",
        description: "Kaftan mai kyau da salo na zamani.",
        price: 25000,
        image: "https://images.unsplash.com/photo-1598033129183-c4f50c736f10?auto=format&fit=crop&w=700&q=80"
      },
      {
        id: 2,
        name: "Traditional Wear",
        description: "Tufafin gargajiya mai kyau.",
        price: 18000,
        image: "https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&w=700&q=80"
      },
      {
        id: 3,
        name: "Classic Shirt",
        description: "Riga mai kyau don yau da kullum.",
        price: 12000,
        image: "https://images.unsplash.com/photo-1596755094514-f87e34085b2c?auto=format&fit=crop&w=700&q=80"
      },
      {
        id: 4,
        name: "Luxury Fabric",
        description: "Yadi mai kyau don ɗinki.",
        price: 15000,
        image: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=700&q=80"
      }
    ];

    let cart = [];

    // TSARA FARASHI
    function formatPrice(amount) {
      return "₦" + amount.toLocaleString("en-NG");
    }

    // NUNA KAYAYYAKI
    function displayProducts() {
      const container = document.getElementById("productsContainer");

      container.innerHTML = products.map(product => `
        <article class="product">
          <img
            src="${product.image}"
            alt="${product.name}"
            loading="lazy"
            onerror="this.onerror=null;this.src='https://placehold.co/600x400?text=Absam+Clothing';"
          >

          <h3>${product.name}</h3>

          <p class="product-description">${product.description}</p>

          <p class="price">${formatPrice(product.price)}</p>

          <label for="size-${product.id}">Zaɓi Size</label>
          <select id="size-${product.id}">
            <option value="">Zaɓi size</option>
            <option value="S">S</option>
            <option value="M">M</option>
            <option value="L">L</option>
            <option value="XL">XL</option>
            <option value="XXL">XXL</option>
            <option value="A auna min">A auna min</option>
          </select>

          <label for="color-${product.id}">Zaɓi Launi</label>
          <select id="color-${product.id}">
            <option value="">Zaɓi launi</option>
            <option value="Black">Black</option>
            <option value="White">White</option>
            <option value="Gold">Gold</option>
            <option value="Blue">Blue</option>
            <option value="Brown">Brown</option>
            <option value="Other">Wani launi</option>
          </select>

          <label for="qty-${product.id}">Yawan Kaya</label>
          <input
            id="qty-${product.id}"
            type="number"
            min="1"
            max="100"
            value="1"
          >

          <button
            class="button"
            type="button"
            onclick="addToCart(${product.id})"
          >
            Ƙara a Cart
          </button>
        </article>
      `).join("");
    }

    // ƘARA KAYA A CART
    function addToCart(productId) {
      const product = products.find(item => item.id === productId);

      const size = document.getElementById(`size-${productId}`).value;
      const color = document.getElementById(`color-${productId}`).value;

      const quantity = Number(
        document.getElementById(`qty-${productId}`).value
      );

      if (!size) {
        alert("Da fatan zaɓi size.");
        return;
      }

      if (!color) {
        alert("Da fatan zaɓi launi.");
        return;
      }

      if (!Number.isInteger(quantity) || quantity < 1 || quantity > 100) {
        alert("Shigar da adadin kaya da ya dace.");
        return;
      }

      cart.push({
        id: product.id,
        name: product.name,
        price: product.price,
        size: size,
        color: color,
        quantity: quantity
      });

      displayCart();

      alert("An ƙara " + product.name + " a cart.");
    }

    // JIMILLAR FARASHI
    function getTotal() {
      return cart.reduce(
        (total, item) => total + item.price * item.quantity,
        0
      );
    }

    // NUNA CART
    function displayCart() {
      const cartItems = document.getElementById("cartItems");
      const cartTotal = document.getElementById("cartTotal");

      if (cart.length === 0) {
        cartItems.innerHTML =
          '<p class="empty">Ba ka saka kaya a cart ba tukuna.</p>';

        cartTotal.textContent = "Jimilla: ₦0";
        return;
      }

      cartItems.innerHTML = cart.map((item, index) => `
        <div class="cart-item">
          <strong>${item.name}</strong>
          <p>Size: ${item.size}</p>
          <p>Launi: ${item.color}</p>
          <p>Yawan kaya: ${item.quantity}</p>
          <p>Farashi: ${formatPrice(item.price * item.quantity)}</p>

          <button type="button" onclick="removeFromCart(${index})">
            Cire Kaya
          </button>
        </div>
      `).join("");

      cartTotal.textContent = "Jimilla: " + formatPrice(getTotal());
    }

    // CIRE KAYA
    function removeFromCart(index) {
      cart.splice(index, 1);
      displayCart();
    }

    // SHARE CART
    function clearCart() {
      if (cart.length === 0) {
        alert("Cart ɗin babu kaya.");
        return;
      }

      if (confirm("Kana son cire duk kayan da ke cart?")) {
        cart = [];
        displayCart();
      }
    }

    // AIKA ODA TA WHATSAPP
    document.getElementById("orderForm").addEventListener(
      "submit",
      function(event) {
        event.preventDefault();

        if (cart.length === 0) {
          alert("Da farko ka zaɓi kaya ka saka a cart.");
          document.getElementById("products").scrollIntoView({
            behavior: "smooth"
          });
          return;
        }

        const name = document.getElementById("customerName").value.trim();
        const phone = document.getElementById("customerPhone").value.trim();
        const address = document.getElementById("customerAddress").value.trim();
        const notes = document.getElementById("customerNotes").value.trim();
        const fabricInput = document.getElementById("fabricImage");

        if (!name || !phone || !address) {
          alert("Cika sunanka, lambar waya da adireshinka.");
          return;
        }

        const itemsText = cart.map((item, index) => {
          return (
            `${index + 1}. ${item.name}\n` +
            `Size: ${item.size}\n` +
            `Launi: ${item.color}\n` +
            `Yawan kaya: ${item.quantity}\n` +
            `Farashi: ${formatPrice(item.price * item.quantity)}`
          );
        }).join("\n\n");

        let message =
          "ASSALAMU ALAIKUM, ABSAM CLOTHING & TEXTILE\n\n" +
          "Ina son yin oda.\n\n" +
          "Sunan kwastoma: " + name + "\n" +
          "Lambar waya: " + phone + "\n" +
          "Adireshi: " + address + "\n\n" +
          "KAYAN DA NA ZAƁA:\n" +
          itemsText + "\n\n" +
          "Jimillar farashi: " + formatPrice(getTotal()) + "\n\n";

        if (notes) {
          message += "Ƙarin bayani: " + notes + "\n\n";
        }

        if (fabricInput.files.length > 0) {
          message +=
            "Ina da hoton yadi; zan tura hoton a WhatsApp da kaina.\n\n";
        }

        message +=
          "Don Allah a tabbatar da samuwar kaya da cikakken bayani kan odar. Na gode.";

        const whatsappURL =
          "https://wa.me/" +
          BUSINESS.whatsapp +
          "?text=" +
          encodeURIComponent(message);

        window.location.href = whatsappURL;
      }
    );

    // SHEKARAR YANZU
    document.getElementById("year").textContent =
      new Date().getFullYear();

    // FARA SHAFIN
    displayProducts();
    displayCart();
  </script>

</body>
</html>
