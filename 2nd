    }

    .eyebrow {
      color: var(--gold);
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 3px;
      margin-bottom: 12px;
    }

    .hero h1 {
      color: var(--gold);
      font-size: clamp(30px, 7vw, 48px);
      line-height: 1.2;
      margin-bottom: 18px;
    }

    .hero p {
      max-width: 600px;
      margin: 0 auto 25px;
      color: #dddddd;
      font-size: 15px;
    }

    .button {
      display: inline-block;
      background: var(--gold);
      color: #080808;
      padding: 13px 21px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: bold;
      border: 1px solid var(--gold);
      cursor: pointer;
      transition: 0.2s;
    }

    .button:hover {
      background: #f4d986;
    }

    section {
      padding: 35px 16px;
      scroll-margin-top: 20px;
    }

    .section-title {
      text-align: center;
      color: var(--gold);
      font-size: 26px;
      margin-bottom: 8px;
    }

    .section-description {
      text-align: center;
      color: var(--muted);
      font-size: 14px;
      margin: 0 auto 24px;
      max-width: 550px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 15px;
      max-width: 950px;
      margin: auto;
    }

    .product {
      min-width: 0;
      background: var(--surface);
      border: 1px solid #44391f;
      border-radius: 10px;
      padding: 10px;
      overflow: hidden;
    }

    .product img {
      display: block;
      width: 100%;
      height: 175px;
      object-fit: cover;
      border-radius: 6px;
      background: #222222;
    }

    .product h3 {
      color: var(--gold);
      font-size: 16px;
      margin: 12px 0 6px;
    }

    .product p {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
    }

    .price {
      color: #ffdc72;
      font-weight: bold;
      margin: 12px 0;
      font-size: 15px;
    }

    .order-button {
      display: block;
      width: 100%;
      padding: 11px 5px;
      background: var(--gold);
      color: #080808;
      text-decoration: none;
      text-align: center;
      border-radius: 5px;
      font-weight: bold;
      font-size: 12px;
    }

    .info-box {
      max-width: 750px;
      margin: auto;
      background: var(--surface);
      border: 1px solid #44391f;
      padding: 22px;
      border-radius: 10px;
      color: #dddddd;
    }

    .info-box p {
      margin-bottom: 10px;
    }

    .info-box strong {
      color: var(--gold);
    }

    .info-box a:not(.button) {
      color: var(--gold);
      overflow-wrap: anywhere;
    }

    .steps {
      padding-left: 22px;
      margin-bottom: 20px;
    }

    .steps li {
      margin-bottom: 9px;
    }

    .contact-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 18px;
    }

    footer {
