<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Absam Clothing | Premium Tailoring</title>

  <meta name="description"
        content="Discover premium men's and children's clothing from Absam Clothing in Kano, Nigeria. Order through WhatsApp.">

  <meta name="theme-color" content="#080808">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JHFM4J7S8C"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', 'G-JHFM4J7S8C');
  </script>

  <style>
    :root {
      --black: #080808;
      --panel: #121212;
      --gold: #d4af37;
      --gold-light: #f4df94;
      --white: #ffffff;
      --muted: #b7b7b7;
      --border: #303030;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--black);
      color: var(--white);
      line-height: 1.6;
    }

    button, input, select, textarea {
      font: inherit;
    }

    button, a {
      -webkit-tap-highlight-color: transparent;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      cursor: pointer;
    }

    .container {
      width: min(1150px, 92%);
      margin: auto;
    }

    .gold {
      color: var(--gold);
    }

    /* ANNOUNCEMENT */

    .announcement {
      background: var(--gold);
      color: #080808;
      text-align: center;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    /* HEADER */

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(8, 8, 8, .97);
      border-bottom: 1px solid var(--border);
    }

    .nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand {
      font-family: Georgia, serif;
      font-size: 23px;
      font-weight: bold;
      letter-spacing: 2px;
      color: var(--gold);
      line-height: 1.2;
    }

    .brand small {
      display: block;
      font-family: Arial, sans-serif;
      color: #ddd;
      font-size: 9px;
      letter-spacing: 4px;
      margin-top: 5px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 23px;
      font-size: 13px;
    }

    .nav-links a:hover {
      color: var(--gold);
    }

    .cart-button {
      background: var(--gold);
      color: #080808;
      border: 0;
      padding: 11px 15px;
      font-weight: bold;
      border-radius: 3px;
    }

    /* HERO */

    .hero {
      min-height: 520px;
      display: flex;
      align-items: center;
      background:
        radial-gradient(ellipse at 85% 45%, #3b3018 0%, transparent 38%),
        linear-gradient(110deg, #080808 25%, #17130a 100%);
      border-bottom: 1px solid #292319;
    }

    .hero-content {
      max-width: 700px;
      padding: 75px 0;
    }

    .eyebrow {
      color: var(--gold);
      font-size: 12px;
      letter-spacing: 4px;
      font-weight: bold;
      text-transform: uppercase;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1.08;
      margin-bottom: 22px;
      font-weight: normal;
    }

    .hero h1 span {
      color: var(--gold);
      font-style: italic;
    }

    .hero p {
      color: #c6c6c6;
      max-width: 510px;
      margin-bottom: 30px;
      font-size: 15px;
    }

    .button {
      display: inline-block;
      padding: 13px 23px;
      border-radius: 3px;
      font-size: 13px;
      font-weight: bold;
      border: 1px solid var(--gold);
      transition: .2s;
    }

    .button-primary {
      background: var(--gold);
      color: #080808;
    }

    .button-outline {
      color: var(--gold);
      margin-left: 8px;
    }

    .button:hover {
      background: var(--gold-light);
      color: #080808;
    }

    /* BENEFITS */

    .benefits {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--border);
    }

    .benefit {
      padding: 24px 12px;
      text-align: center;
      border-right: 1px solid var(--border);
    }

    .benefit:last-child {
      border-right: 0;
    }

    .benefit strong {
      color: var(--gold);
      display: block;
      font-size: 13px;
      margin-bottom: 5px;
    }

    .benefit span {
      color: var(--muted);
      font-size: 12px;
    }

    /* SECTIONS */

    section {
      scroll-margin-top: 90px;
    }

    .section {
      padding: 75px 0;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 32px;
    }

    .section-heading .eyebrow {
      margin-bottom: 8px;
    }

    .section-heading h2 {
      font-family: Georgia, serif;
      font-size: clamp(30px, 5vw, 42px);
      font-weight: normal;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 13px;
      margin-top: 10px;
    }

    /* CATEGORY TABS */

    .category-tabs {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-bottom: 32px;
      flex-wrap: wrap;
    }

    .category-tab {
      background: transparent;
      color: #eee;
      border: 1px solid #444;
      border-radius: 3px;
      padding: 11px 23px;
      font-size: 13px;
    }

    .category-tab.active,
    .category-tab:hover {
      color: #080808;
      background: var(--gold);
      border-color: var(--gold);
    }

    /* PRODUCTS */

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }

    .product-card {
      background: var(--panel);
      border: 1px solid #292929;
      overflow: hidden;
      transition: transform .2s, border-color .2s;
    }

    .product-card:hover {
      transform: translateY(-4px);
      border-color: var(--gold);
    }

    .product-image {
      aspect-ratio: 4 / 4.5;
      background: #1b1b1b;
      position: relative;
      overflow: hidden;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .product-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      padding: 5px 9px;
      background: var(--gold);
      color: #080808;
      font-size: 10px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    .product-info {
      padding: 18px;
    }

    .product-info h3 {
      font-family: Georgia, serif;
      font-size: 21px;
      font-weight: normal;
      margin-bottom: 6px;
    }

    .product-description {
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 12px;
    }

    .product-price {
      color: var(--gold);
      font-size: 16px;
      font-weight: bold;
      margin-bottom: 16px;
    }

    .product-actions {
      display: flex;
      gap: 8px;
    }

    .product-actions button {
      flex: 1;
      min-width: 0;
      padding: 10px 5px;
      font-size: 11px;
    }

    .add-button {
      border: 1px solid var(--gold);
      background: var(--gold);
      color: #080808;
      font-weight: bold;
    }

    .inquire-button {
      border: 1px solid #555;
      background: transparent;
      color: #eee;
    }

    .inquire-button:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    /* ABOUT */

    .about {
      background: #111;
      border-top: 1px solid #292929;
      border-bottom: 1px solid #292929;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 50px;
    }

    .about-mark {
      min-height: 300px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      border: 1px solid #54451f;
      background: radial-gradient(ellipse, #272012, #090909 70%);
    }

    .about-mark .needle {
      font-size: 52px;
      color: var(--gold);
      margin-bottom: 15px;
    }

    .about-mark strong {
      font-family: Georgia, serif;
      color: var(--gold);
      font-size: 28px;
      letter-spacing: 3px;
    }

    .about-mark span {
      color: #ddd;
      letter-spacing: 5px;
      font-size: 10px;
      margin-top: 8px;
    }

    .about-copy h2 {
      font-family: Georgia, serif;
      font-weight: normal;
      font-size: 38px;
      line-height: 1.2;
      margin-bottom: 18px;
    }

    .about-copy p {
      color: #bbb;
      font-size: 14px;
      margin-bottom: 18px;
    }

    /* CONTACT */

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .contact-card {
      background: var(--panel);
      border: 1px solid var(--border);
      padding: 25px;
      text-align: center;
    }

    .contact-card .icon {
      font-size: 28px;
      margin-bottom: 10px;
    }

    .contact-card h3 {
      color: var(--gold);
      font-size: 15px;
      margin-bottom: 8px;
    }

    .contact-card p {
      color: var(--muted);
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    /* CART */

    .cart-section {
      background: #101010;
      border-top: 1px solid var(--border);
    }

    .cart-panel {
      max-width: 800px;
      margin: auto;
      border: 1px solid #363636;
      background: #0a0a0a;
      padding: 24px;
    }

    .cart-empty {
      text-align: center;
      color: var(--muted);
      padding: 20px 0;
      font-size: 14px;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: 15px;
      padding: 15px 0;
      border-bottom: 1px solid #292929;
    }

    .cart-item h4 {
      font-size: 14px;
    }

    .cart-item small {
      color: var(--muted);
      display: block;
    }

    .quantity-controls {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .quantity-controls button,
    .remove-button {
      background: #222;
      border: 1px solid #444;
      color: white;
      padding: 5px 10px;
      border-radius: 3px;
    }

    .remove-button {
      color: #ff8a8a;
    }

    .cart-total {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding: 22px 0;
      font-weight: bold;
      font-size: 17px;
    }

    .cart-total strong {
      color: var(--gold);
    }

    .checkout-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 12px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    .form-group label {
      color: #ddd;
      font-size: 12px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      background: #151515;
      color: white;
      border: 1px solid #393939;
      border-radius: 3px;
      padding: 12px;
      width: 100%;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: 1px solid var(--gold);
    }

    .form-group option {
      background: #151515;
    }

    .payment-note {
      color: var(--muted);
      font-size: 12px;
      margin-top: 10px;
    }

    .checkout-button {
      width: 100%;
      border: none;
      margin-top: 16px;
      padding: 15px;
      background: #25d366;
      color: #061b0d;
      font-weight: bold;
      border-radius: 3px;
    }

    .checkout-button:hover {
      background: #5ce58b;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid #292929;
      padding: 35px 0;
      text-align: center;
      color: var(--muted);
      font-size: 12px;
    }

    footer .brand {
      display: inline-block;
      margin-bottom: 14px;
    }

    .footer-links {
      margin: 14px 0;
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .footer-links a:hover {
      color: var(--gold);
    }

    /* WHATSAPP FLOATING BUTTON */

    .whatsapp-float {
      position: fixed;
      bottom: 20px;
      right: 18px;
      z-index: 90;
      background: #25d366;
      color: #061b0d;
      padding: 13px 16px;
      border-radius: 30px;
      box-shadow: 0 4px 20px #0008;
      font-weight: bold;
      font-size: 12px;
    }

    /* RESPONSIVE */

    @media (max-width: 760px) {
      .nav {
        min-height: 68px;
        flex-wrap: wrap;
        padding: 12px 0;
      }

      .brand {
        font-size: 20px;
      }

      .nav-links {
        order: 3;
        width: 100%;
        justify-content: space-between;
        gap: 10px;
        font-size: 12px;
      }

      .cart-button {
        padding: 9px 11px;
        font-size: 12px;
      }

      .hero {
        min-height: 440px;
      }

      .hero-content {
        padding: 60px 0;
      }

      .hero h1 {
        font-size: 45px;
      }

      .benefit {
        padding: 18px 6px;
      }

      .benefit strong {
        font-size: 11px;
      }

      .benefit span {
        font-size: 10px;
      }

      .section {
        padding: 55px 0;
      }

      .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .product-info {
        padding: 12px;
      }

      .product-info h3 {
        font-size: 17px;
      }

      .product-description {
        font-size: 11px;
      }

      .product-actions {
        flex-direction: column;
      }

      .about-grid {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .about-mark {
        min-height: 220px;
      }

      .contact-grid {
        grid-template-columns: 1fr;
      }

      .cart-panel {
        padding: 15px;
      }

      .cart-item {
        grid-template-columns: 1fr auto;
        gap: 10px;
      }

      .cart-item .quantity-controls {
        grid-column: 1;
      }

      .cart-item .remove-button {
        grid-column: 2;
        grid-row: 1 / span 2;
      }

      .checkout-form {
        grid-template-columns: 1fr;
      }

      .form-group.full {
        grid-column: auto;
      }

      .button-outline {
        margin: 12px 0 0;
      }
    }

    @media (max-width: 370px) {
      .product-grid {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: 39px;
      }
    }
  </style>
</head>

<body>

  <div class="announcement">
    ABSAM CLOTHING — STYLE THAT SPEAKS
  </div>

  <header>
    <div class="container nav">

      <a href="#home" class="brand">
        ABSAM CLOTHING
        <small>PREMIUM TAILORING</small>
      </a>

      <nav class="nav-links" aria-label="Main navigation">
        <a href="#home">Home</a>
        <a href="#collection">Collection</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>

      <a href="#cart" class="cart-button">
        🛍️ Cart (<span id="cart-count">0</span>)
      </a>

    </div>
  </header>

  <main>

    <!-- HERO -->

    <section class="hero" id="home">
      <div class="container">
        <div class="hero-content">

          <div class="eyebrow">Elegance in Every Stitch</div>

          <h1>
            Dress With<br>
            <span>Distinction.</span>
          </h1>

          <p>
            Discover exceptional tailoring and timeless style.
            From elegant traditional outfits to modern designs,
            Absam Clothing brings your style to life.
          </p>

          <a href="#collection" class="button button-primary">
            EXPLORE COLLECTION
          </a>

          <a href="#about" class="button button-outline">
            OUR STORY
          </a>

        </div>
      </div>
    </section>

    <!-- BENEFITS -->

    <div class="container">
      <div class="benefits">

        <div class="benefit">
          <strong>✦ QUALITY CRAFTSMANSHIP</strong>
          <span>Care in every detail</span>
        </div>

        <div class="benefit">
          <strong>✦ TIMELESS STYLE</strong>
          <span>Made to stand out</span>
        </div>

        <div class="benefit">
          <strong>✦ PERSONAL SERVICE</strong>
          <span>Your style, your choice</span>
        </div>

      </div>
    </div>

    <!-- COLLECTION -->

    <section class="section" id="collection">
      <div class="container">

        <div class="section-heading">
          <div class="eyebrow">Our Collection</div>
          <h2>Discover Your <span class="gold">Style</span></h2>
          <p>Explore our clothing collection for adults and children.</p>
        </div>

        <div class="category-tabs">
          <button class="category-tab active"
                  data-category="men"
                  onclick="showCategory('men', this)">
            Men's Collection
          </button>

          <button class="category-tab"
                  data-category="children"
                  onclick="showCategory('children', this)">
            Children's Collection
          </button>
        </div>

        <div class="product-grid" id="product-grid"></div>

      </div>
    </section>

    <!-- ABOUT -->

    <section class="section about" id="about">
      <div class="container about-grid">

        <div class="about-mark">
          <div class="needle">✦</div>
          <strong>ABSAM</strong>
          <span>CLOTHING</span>
        </div>

        <div class="about-copy">
          <div class="eyebrow">About Our Brand</div>

          <h2>Tradition Meets <span class="gold">Modern Elegance.</span></h2>

          <p>
            At Absam Clothing, we believe that what you wear should
            express your personality and confidence.
          </p>

          <p>
            We offer traditional and contemporary clothing with
            attention to detail, helping you look your best for
            everyday wear and special occasions.
          </p>

          <a href="#collection" class="button button-primary">
            VIEW COLLECTION
          </a>
        </div>

      </div>
    </section>

    <!-- CART AND CHECKOUT -->

    <section class="section cart-section" id="cart">
      <div class="container">

        <div class="section-heading">
          <div class="eyebrow">Your Selection</div>
          <h2>Shopping <span class="gold">Cart</span></h2>
          <p>Review your selected items before placing an order.</p>
        </div>

        <div class="cart-panel">

          <div id="cart-items">
            <div class="cart-empty">
              Your cart is empty. Explore our collection to get started.
            </div>
          </div>

          <div class="cart-total">
            <span>Total</span>
            <strong id="cart-total">₦0</strong>
          </div>

          <form id="checkout-form" onsubmit="placeOrder(event)">

            <div class="checkout-form">

              <div class="form-group">
                <label for="customer-name">Full name *</label>
                <input id="customer-name"
                       name="name"
                       type="text"
                       autocomplete="name"
                       required
                       placeholder="Enter your full name">
              </div>

              <div class="form-group">
                <label for="customer-phone">Phone number *</label>
                <input id="customer-phone"
                       name="phone"
                       type="tel"
                       autocomplete="tel"
                       required
                       placeholder="Enter your phone number">
              </div>

              <div class="form-group">
                <label for="customer-category">Collection *</label>
                <select id="customer-c
