      font-weight: bold;
      font-size: 16px;
      letter-spacing: 2px;
      margin-bottom: 5px;
    }

    nav {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      display: flex;
      justify-content: space-around;
      background: #141414;
      border-top: 1px solid var(--gold-border);
      padding: 9px 2px calc(9px + env(safe-area-inset-bottom));
