    }

    header {
      text-align: center;
      padding: 24px 15px;
      background: #101010;
      border-bottom: 1px solid var(--gold-border);
    }

    .logo {
      color: var(--gold);
      font-size: clamp(23px, 5vw, 32px);
      font-weight: 800;
      letter-spacing: 2px;
    }

    .tagline {
      color: var(--muted);
      margin-top: 5px;
      font-size: 14px;
    }

    .location {
      color: var(--gold);
      font-size: 12px;
      margin-top: 5px;
    }

    .hero {
      text-align: center;
      padding: 60px 20px;
      background:
        radial-gradient(
          ellipse at top,
          #292313 0%,
          #111111 45%,
          #080808 100%
