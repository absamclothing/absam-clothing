    :root {
      --background: #080808;
      --surface: #151515;
      --gold: #e5c568;
      --gold-border: #8f783c;
      --white: #ffffff;
      --muted: #c5c5c5;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--background);
      color: var(--white);
