<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Absam Clothing</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: #080808;
  color: white;
  font-family: Arial, sans-serif;
  padding-bottom: 85px;
}

header {
  text-align: center;
  padding: 25px 10px;
  background: #111;
  border-bottom: 1px solid #b89b48;
}

.logo {
  color: #e5c568;
  font-size: 26px;
  font-weight: bold;
  letter-spacing: 2px;
}

header p {
  color: #bbb;
  margin-top: 8px;
}

.hero {
  padding: 40px 20px;
  text-align: center;
  background: linear-gradient(#171717, #080808);
}

.hero h1 {
  color: #e5c568;
  font-size: 32px;
  margin-bottom: 15px;
}

.hero p {
  color: #ddd;
  line-height: 1.7;
  margin-bottom: 25px;
}

.button {
  display: inline-block;
  background: #e5c568;
  color: #080808;
  padding: 14px 22px;
  border-radius: 7px;
  text-decoration: none;
  font-weight: bold;
  border: none;
  cursor: pointer;
}

section {
  padding: 25px 16px;
  scroll-margin-top: 15px;
}

.section-title {
  color: #e5c568;
  font-size: 25px;
  margin-bottom: 20px;
  text-align: center;
}

.products {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.product {
  background: #191919;
  border: 1px solid #66552c;
  border-radius: 10px;
  padding: 10px;
  overflow: hidden;
}

.product img {
  width: 100%;
  height: 170px;
  object-fit: cover;
  border-radius: 6px;
}

.product h3 {
  color: #e5c568;
  font-size: 16px;
  margin: 12px 0 8px;
}

.product p {
  color: #ccc;
  font-size: 13px;
  line-height: 1.5;
}

.price {
  color: #ffd700;
  font-weight: bold;
  margin: 12px 0;
}

.order-button {
  display: block;
  width: 100%;
  padding: 11px 5px;
  background: #e5c568;
  color: #080808;
  text-decoration: none;
  text-align: center;
  border-radius: 5px;
  font-weight: bold;
  font-size: 13px;
}

.info-box {
  background: #191919;
  border: 1px solid #66552c;
  padding: 20px;
  border-radius: 10px;
  line-height: 1.9;
}

.info-box a {
  color: #e5c568;
}

footer {
  text-align: center;
  padding: 25px 10px;
  color: #aaa;
  font-size: 13px;
}

nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-around;
  background: #171717;
  border-top: 1px solid #66552c;
  padding: 12px 2px;
  z-index: 100;
}

nav a {
  color: #ddd;
  text-decoration: none;
  text-align: center;
  font-size: 11px;
  flex: 1;
}

nav a span {
  display: block;
  font-size: 20px;
  margin-bottom: 5px;
}

@media (max-width: 360px) {
  .products {
    grid-template-columns: 1fr;
  }

  .product img {
    height: 230px;
  }
}
</style>
</head>

